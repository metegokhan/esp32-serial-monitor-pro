{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serial Monitor Pro",
  "version": "2.0.0",
  "identifier": "com.metegokhan.serialmonitorpro",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Serial Monitor Pro",
        "url": "index.html",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
