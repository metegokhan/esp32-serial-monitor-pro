                data["session_id"] = target
        print_result(request("/api/disconnect", "POST", data))

    elif cmd in ("cancel", "abort"):
        session_id = None
        send_break = False
        json_output = False
        for a in args[1:]:
            if a in ("--break", "-b", "--stop"):
                send_break = True
            elif a == "--json":
                json_output = True
            elif not a.startswith("-") and not session_id:
                session_id = a
        data = {"send_break": send_break}
        if session_id:
            data["session_id"] = session_id
        res = request("/api/cancel", "POST", data)
        if json_output:
            print_result(res)
        else:
            if isinstance(res, dict) and res.get("ok"):
                print("🛑 [İPTAL EDİLDİ]")
                print(f"  • Kapsam       : {res.get('scope', 'Doğrulama bekleyişi sonlandırıldı')}")
                if res.get("send_break"):
                    print("  • Donanım      : ⚡ ESP32'ye kesme / durdurma sinyali (Ctrl+C / \\x03) iletildi.")
                else:
                    print("  • Cihaz Durumu : ℹ️ ESP32 donanım üzerinde çalışmaya devam edebilir (Durdurma komutu veya reset iletilmedi).")
                    print("  • İpucu        : Cihazı da durdurmak için: 'smp cancel --break' veya 'smp reset' kullanın.")
            else:
                print_result(res)

    elif cmd == "send":
        session_id = None
        delay_ms = None
        raw_mode = False
        file_path = None
        text_parts = []
        i = 1
        while i < len(args):
            a = args[i]
            if a in ("--session", "-s") and i + 1 < len(args):
                session_id = args[i + 1]
                i += 2
            elif a in ("--delay", "-d") and i + 1 < len(args):
                delay_ms = int(args[i + 1])
                i += 2
            elif a in ("--file", "-f") and i + 1 < len(args):
                file_path = args[i + 1]
                i += 2
            elif a == "--raw":
                raw_mode = True
                i += 1
            else:
                text_parts.append(a)
                i += 1

        content = ""
        if file_path:
            try:
                with open(file_path, "r", encoding="utf-8") as f:
                    content = f.read()
            except Exception as e:
                print(f"Hata: Dosya okunamadı: {e}")
                sys.exit(1)
        elif text_parts and text_parts[0] == "-":
            content = sys.stdin.read()
        else:
            content = " ".join(text_parts)

        data = {"data": content}
        if session_id:
            data["session_id"] = session_id
        if delay_ms is not None:
            data["line_delay_ms"] = delay_ms
        lines_count = len(content.splitlines()) if content else 1
        send_timeout = max(30.0, (lines_count * (delay_ms or 25) / 1000.0) + 30.0)
        print_result(request("/api/send", "POST", data, timeout=send_timeout))

    elif cmd == "exec":
        if len(args) < 2:
            print("Kullanım: ./smp exec <komut> [--timeout ms] [--expect text] [--start text] [--delay ms] [--json]")
            sys.exit(1)
        timeout_ms = 5000
        expect_str = None
        start_str = None
        delay_ms = None
        session_id = None
        json_output = False
        text_parts = []
        i = 1
        while i < len(args):
            a = args[i]
            if a in ("--timeout", "-t") and i + 1 < len(args):
                timeout_ms = int(args[i + 1])
                i += 2
            elif a in ("--expect", "-e", "--verify") and i + 1 < len(args):
                expect_str = args[i + 1]
                i += 2
            elif a in ("--start",) and i + 1 < len(args):
                start_str = args[i + 1]
                i += 2
            elif a in ("--delay", "-d") and i + 1 < len(args):
                delay_ms = int(args[i + 1])
                i += 2
            elif a in ("--session", "-s") and i + 1 < len(args):
                session_id = args[i + 1]
                i += 2
            elif a == "--json":
                json_output = True
                i += 1
            else:
                text_parts.append(a)
                i += 1

        cmd_text = " ".join(text_parts)
        req_payload = {
            "command": cmd_text,
            "timeout_ms": timeout_ms
        }
        if expect_str:
            req_payload["expect"] = expect_str
        if start_str:
            req_payload["start_expect"] = start_str
        if delay_ms is not None:
            req_payload["line_delay_ms"] = delay_ms
        if session_id:
            req_payload["session_id"] = session_id

        # Setup Ctrl+C handler to cancel the running operation on the server
        def sigint_handler(sig, frame):
            print("\n⚠️ [İPTAL] Ctrl+C algılandı, işlem durduruluyor...")
            try:
                request("/api/cancel", "POST", {"session_id": session_id} if session_id else {})
            except Exception:
                pass
            sys.exit(130)

        prev_handler = signal.signal(signal.SIGINT, sigint_handler)

        http_timeout_sec = (timeout_ms / 1000.0) + 15.0
        try:
            res = request("/api/exec", "POST", req_payload, timeout=http_timeout_sec)
        finally:
            signal.signal(signal.SIGINT, prev_handler)

        if json_output:
            print_result(res)
        else:
            if isinstance(res, dict):
                lines = res.get("response_lines", [])
                if lines:
                    print("\n".join(lines))
                else:
                    if not res.get("cancelled"):
                        print(f"(Cihazdan çıktı satırı gelmedi - {res.get('duration_ms', 0)}ms)")

                stages = res.get("stages", {})
