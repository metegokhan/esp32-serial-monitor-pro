                        elif verdict == "PLAYBACK_PREMATURE_OR_SKIPPED":
                            print("  ⚠️ [ERKEN GEÇİŞ / AKIŞ KESİNTİSİ] Parça doğal olarak bitmedi!")
                            print("     Cihaz loglarında 'transition=1' (erken atlama) veya 'http_complete=0' (akış kesintisi) tespit edildi.")
                            print("     Doğrulama kuralı: Oynatmanın başarılı sayılması için 'http_complete=1' VE 'transition=0' şarttır.")
                        elif verdict == "EXECUTED_MARKER_MISMATCH":
                            print(f"  ⚠️ [İŞARET UYUŞMAZLIĞI] Komut cihazda başarıyla çalıştı ve log üretti (Çökme yok).")
                            print(f"     Ancak aranan '{expect_str}' deseni log akışında görülmedi.")
                            print("     Öneri: Donanımın kararlı tamamlama işaretini kullanın: --expect \"TINYMUSIC_STREAM complete\"")
                        elif verdict == "DEVICE_CRASH_OR_ERROR":
                            print("  ❌ [CİHAZ HATASI] Cihaz çıktısında çökme veya panic (Guru Meditation / abort / heap) tespit edildi!")
                        elif verdict == "TIMEOUT_NO_RESPONSE":
                            print("  ⏳ [YANITSIZ ZAMAN AŞIMI] Komuta karşılık cihazdan hiçbir satır gelmedi.")
                        elif verdict == "CANCELLED":
                            print("  🛑 [İPTAL EDİLDİ] Yalnızca Serial Monitor Pro doğrulama bekleyişi durduruldu (Host-side).")
                            print("     ESP32 mikrodenetleyicisi donanım üzerindeki görevini sürdürmektedir.")
                            print("     Cihazı da durdurmak isterseniz: 'smp cancel --break' veya 'smp reset' kullanın.")

                        if verdict_detail and verdict not in ("PASSED_VERIFIED",):
                            print(f"  • Detay: {verdict_detail}")
                    elif res.get("cancelled"):
                        print("⚠️ [İPTAL BİLGİSİ] Komut veya aktarım kullanıcı tarafından iptal edildi.")
                else:
                    print_result(res)
            else:
                print_result(res)

    elif cmd in ("shell", "sh"):
        if len(args) < 2:
            print("Kullanım: ./smp shell <komut> [--cwd dizin]")
            sys.exit(1)
        cwd = None
        text_parts = []
        i = 1
        while i < len(args):
            if args[i] in ("--cwd", "-C") and i + 1 < len(args):
                cwd = args[i + 1]
                i += 2
            else:
                text_parts.append(args[i])
                i += 1
        shell_cmd = " ".join(text_parts)
        payload = {"command": shell_cmd}
        if cwd:
            payload["cwd"] = cwd
        res = request("/api/shell", "POST", payload)
        if isinstance(res, dict) and "stdout" in res:
            if res.get("stdout"):
                sys.stdout.write(res["stdout"])
            if res.get("stderr"):
                sys.stderr.write(res["stderr"])
            sys.exit(res.get("exit_code", 0))
        else:
            print_result(res)

    elif cmd in ("logs", "log"):
        tail = 50
        filter_term = ""
        session_id = None
        i = 1
        while i < len(args):
            if args[i] in ("--tail", "-n") and i + 1 < len(args):
                tail = int(args[i + 1])
                i += 2
            elif args[i] in ("--filter", "-f") and i + 1 < len(args):
                filter_term = args[i + 1]
                i += 2
            elif args[i] in ("--session", "-s") and i + 1 < len(args):
                session_id = args[i + 1]
                i += 2
            else:
                i += 1
        query = f"?tail={tail}"
        if filter_term:
            query += f"&filter={urllib.parse.quote(filter_term)}"
        if session_id:
            query += f"&session_id={urllib.parse.quote(session_id)}"
        print_result(request(f"/api/logs{query}"))

    elif cmd == "reset":
        session_id = args[1] if len(args) > 1 and not args[1].startswith("-") else None
        data = {"session_id": session_id} if session_id else {}
        print_result(request("/api/reset", "POST", data))

    elif cmd == "boot":
        session_id = args[1] if len(args) > 1 and not args[1].startswith("-") else None
        data = {"session_id": session_id} if session_id else {}
        print_result(request("/api/boot", "POST", data))

    elif cmd == "pin":
        line_idx = -1
        i = 1
        if len(args) > 1:
            first_arg = args[1]
            if first_arg.isdigit():
                val = int(first_arg)
                line_idx = max(0, val - 1)
                i = 2
            elif first_arg.lower() in ("last", "son", "-1"):
                line_idx = -1
                i = 2
            elif not first_arg.startswith("-"):
                # E.g. ./smp pin "cızırtı duyuldu" --preset 2
                line_idx = -1
                i = 1
            else:
                # E.g. ./smp pin --preset 1
                line_idx = -1
                i = 1

        note_words = []
        preset_id = None
        shape = None
        color = None
        emoji = None
        desc = None
        session_id = None

        while i < len(args):
            arg = args[i]
            if arg in ("--preset", "-p") and i + 1 < len(args):
                preset_id = args[i + 1]
                i += 2
            elif arg == "--shape" and i + 1 < len(args):
                shape = args[i + 1]
                i += 2
            elif arg == "--color" and i + 1 < len(args):
                color = args[i + 1]
                i += 2
            elif arg == "--emoji" and i + 1 < len(args):
                emoji = args[i + 1]
                i += 2
            elif arg in ("--desc", "--description") and i + 1 < len(args):
                desc = args[i + 1]
                i += 2
            elif arg in ("--session", "-s") and i + 1 < len(args):
                session_id = args[i + 1]
                i += 2
            else:
                note_words.append(arg)
                i += 1

        note = " ".join(note_words)
        pin_payload = {"line_index": line_idx}
        if note:
            pin_payload["note"] = note
        if session_id:
            pin_payload["session_id"] = session_id

        if preset_id and preset_id in DEFAULT_PRESETS:
            p = DEFAULT_PRESETS[preset_id]
            pin_payload["shape"] = shape or p["shape"]
            pin_payload["color"] = color or p["color"]
            pin_payload["emoji"] = emoji or p["emoji"]
            pin_payload["description"] = desc or note or p["description"]
            pin_payload["key"] = preset_id
        else:
            if shape:
                pin_payload["shape"] = shape
            if color:
                pin_payload["color"] = color
            if emoji:
                pin_payload["emoji"] = emoji
            if desc:
                pin_payload["description"] = desc

        print_result(request("/api/pin", "POST", pin_payload))

    elif cmd == "pins":
        print_result(request("/api/pins"))

    elif cmd in ("pin-remove", "unpin"):
        if len(args) < 2:
            print("Kullanım: ./smp pin-remove <pin_id_veya_satır_no>")
            sys.exit(1)
        target = args[1]
        data = {}
        if target.isdigit():
            data["line_index"] = int(target) - 1
        else:
            data["pin_id"] = target
        print_result(request("/api/pin", "DELETE", data))

    elif cmd == "filter":
        if len(args) < 2:
            print("Kullanım: ./smp filter <add|remove|clear> [kelimeler...]")
            sys.exit(1)
        sub = args[1].lower()
        if sub == "clear":
            print_result(request("/api/filter", "POST", {"action": "clear", "tags": []}))
        elif sub in ("add", "remove"):
            raw = " ".join(args[2:])
            tags = [t.strip() for t in raw.split(",") if t.strip()]
            print_result(request("/api/filter", "POST", {"action": sub, "tags": tags}))
        else:
            raw = " ".join(args[1:])
            tags = [t.strip() for t in raw.split(",") if t.strip()]
            print_result(request("/api/filter", "POST", {"action": "add", "tags": tags}))

    elif cmd == "trigger":
        if len(args) < 2:
            print("Kullanım: ./smp trigger <add|remove|clear> [kelime]")
            sys.exit(1)
        sub = args[1].lower()
        if sub == "clear":
            print_result(request("/api/trigger", "POST", {"action": "clear", "tags": []}))
        else:
            tags = [args[2].strip()] if len(args) > 2 else [args[1].strip()]
            print_result(request("/api/trigger", "POST", {"action": "add", "tags": tags}))

    elif cmd == "archives":
        print_result(request("/api/archives"))

    elif cmd in ("ai-logs", "ailogs"):
        print_result(request("/api/ai-logs"))

    else:
        print(f"Bilinmeyen komut: '{cmd}'. Komut listesi ve AI yetenek kılavuzu için: ./smp help", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
