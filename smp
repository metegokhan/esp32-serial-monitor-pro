AI_MODEL_ENV = os.environ.get("AI_MODEL", "AI-Agent")
AI_CLIENT_ENV = os.environ.get("AI_CLIENT", "terminal-client")

def request(path, method="GET", data=None, model_name=None, client_id=None, timeout=None):
    url = f"{API_BASE}{path}"
    req = urllib.request.Request(url, method=method)
    req.add_header("Content-Type", "application/json")

    m = model_name or AI_MODEL_ENV
    c = client_id or AI_CLIENT_ENV
    if m:
        req.add_header("X-AI-Model", m)
    if c:
        req.add_header("X-AI-Client", c)

    body = None
    if data is not None:
        body = json.dumps(data).encode("utf-8")

    http_timeout = timeout if timeout is not None else 15.0

    try:
        with urllib.request.urlopen(req, data=body, timeout=http_timeout) as resp:
            content = resp.read().decode("utf-8")
            content_type = resp.headers.get("Content-Type", "")
            if "application/json" in content_type:
                try:
                    return json.loads(content)
                except Exception:
                    return content
            return content
    except urllib.error.HTTPError as e:
        # Server is RUNNING and responded with 4xx or 5xx (e.g. 400 Bad Request)
        try:
            err_body = e.read().decode("utf-8")
            if "application/json" in e.headers.get("Content-Type", ""):
                try:
                    return json.loads(err_body)
                except Exception:
                    pass
            return {"ok": False, "status": e.code, "error": err_body or str(e)}
        except Exception:
            return {"ok": False, "status": e.code, "error": str(e)}
    except urllib.error.URLError as e:
        if "timed out" in str(e).lower() or isinstance(e.reason, TimeoutError):
            print(f"❌ [SMP CLI Zaman Aşımı] İstek zaman aşımına uğradı ({url}, {http_timeout}s): {e.reason}", file=sys.stderr)
            return {"ok": False, "timeout": True, "error": f"HTTP Timeout: {e.reason}"}
        if path in ("/api/skill", "/skill", "/help"):
            return FALLBACK_SKILL_DOC
        print(f"❌ [SMP CLI Hatası] Serial Monitor Pro servisine ulaşılamadı ({url}): {e.reason}", file=sys.stderr)
        print("Lütfen Serial Monitor Pro uygulamasını çalıştırın (`./run_v2.sh`).", file=sys.stderr)
        sys.exit(1)

def print_result(res):
    if isinstance(res, (dict, list)):
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        print(res)

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help", "skill", "--skill"):
        # Print Skill Document for AI Agents
        res = request("/api/skill")
        print_result(res)
        return

    cmd = args[0].lower()

    if cmd == "status":
        print_result(request("/api/status"))

    elif cmd in ("ai-models", "models", "peers"):
        print_result(request("/api/ai-models"))

    elif cmd == "ports":
        print_result(request("/api/ports"))

    elif cmd == "connect":
        port = "auto"
        baud = 115200
        reset = False
        session_id = None
        match_hint = None
        json_output = False
        i = 1
        if len(args) > 1 and not args[1].startswith("-"):
            port = args[1]
            i = 2
        while i < len(args):
            a = args[i]
            if a.isdigit():
                baud = int(a)
                i += 1
            elif a == "--reset":
                reset = True
                i += 1
            elif a in ("--match", "-m") and i + 1 < len(args):
                match_hint = args[i + 1]
                i += 2
            elif a in ("--session", "-s") and i + 1 < len(args):
                session_id = args[i + 1]
                i += 2
            elif a == "--json":
                json_output = True
                i += 1
            else:
                i += 1
        data = {"port": port, "baud": baud, "reset": reset}
        if session_id:
            data["session_id"] = session_id
        if match_hint:
            data["match"] = match_hint

        res = request("/api/connect", "POST", data)
        if json_output:
            print_result(res)
        else:
            if isinstance(res, dict) and res.get("ok"):
                mode_str = "⚠️ RESETLİ BAĞLANTI" if reset else "🛡️ GÜVENLİ BAĞLANTI (Reset Kapalı, DTR/RTS Nötr)"
