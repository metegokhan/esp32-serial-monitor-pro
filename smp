                if res.get("message"):
                    print(f"  {res.get('message')}")
            else:
                err_msg = res.get("error") if isinstance(res, dict) else str(res)
                target = res.get("port", port) if isinstance(res, dict) else port
                print(f"❌ [BAĞLANTI HATASI] '{target}' portuna bağlanılamadı:")
                print(f"  • Hata: {err_msg}")

    elif cmd == "probe":
        port = "auto"
        baud = 115200
        json_output = False
        i = 1
        if len(args) > 1 and not args[1].startswith("-"):
            port = args[1]
            i = 2
        while i < len(args):
            a = args[i]
            if a.isdigit():
                baud = int(a)
                i += 1
            elif a == "--json":
                json_output = True
                i += 1
            else:
                i += 1
        res = request("/api/probe", "POST", {"port": port, "baud": baud})
        if json_output:
            print_result(res)
        else:
            if isinstance(res, dict) and res.get("ok"):
                pr = res.get("probe", {})
                print(f"🔍 [KİMLİK & PROTOKOL SORGUSU] Port: {pr.get('port_name')} @ {pr.get('baud_rate')} baud")
                print(f"  • Yonga Ailesi : {pr.get('chip_family')}")
                if pr.get("is_active_session"):
                    sess_id = pr.get("active_session_id", "aktif")
                    print(f"  • Oturum       : 🟢 Açık ve Aktif ({sess_id})")
                    print(f"  • Yanıt Durumu : ✅ Aktif Akış Alınıyor (Cihaz çalışıyor)")
                else:
                    if pr.get('responsive'):
